# Publisher OAuth clients for the Electron main process.
# electron-vite embeds MAIN_VITE_* at build time. Copy this file to .env.local
# and fill it there. .env, .env.local, and .env.production.local are gitignored.
# Do not commit client IDs or secrets. Do not add a Slack client here.

# Google Desktop client. The secret is optional and only needed when that
# Desktop registration requires one.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=

# X Native public client. No client secret.
MAIN_VITE_X_CLIENT_ID=

# BlinkyBot GitHub App. The token endpoint requires the client secret.
MAIN_VITE_GITHUB_CLIENT_ID=
MAIN_VITE_GITHUB_CLIENT_SECRET=
