{
  "display_information": {
    "name": "BlinkyBot Desktop",
    "description": "Browser authorization for user-reviewed Slack message drafts",
    "background_color": "#151c19"
  },
  "oauth_config": {
    "redirect_urls": ["http://localhost:47840/oauth/slack/callback"],
    "scopes": {
      "user": ["chat:write", "channels:read", "groups:read", "im:read", "mpim:read"]
    },
    "pkce_enabled": true
  },
  "settings": {
    "socket_mode_enabled": false,
    "org_deploy_enabled": false,
    "token_rotation_enabled": true
  }
}
