{
  "name": "openbot",
  "version": "0.2.0",
  "description": "BlinkyBot: a local-first Mac app for the agent CLIs and API keys you already have. MIT fork of OpenBOT.",
  "keywords": [
    "electron",
    "desktop",
    "agent",
    "ai",
    "local-first",
    "coding-agent",
    "cli",
    "kanban",
    "skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harrisliangsu/blinky-bot.git"
  },
  "homepage": "https://github.com/harrisliangsu/blinky-bot#readme",
  "bugs": {
    "url": "https://github.com/harrisliangsu/blinky-bot/issues"
  },
  "author": "BlinkyBot contributors",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "vm-daemon": "node out/main/vmDaemon.js",
    "dist": "node -e \"require('electron')\" && electron-vite build && electron-builder --mac",
    "pack": "node -e \"require('electron')\" && electron-vite build && electron-builder --mac --dir",
    "package:mac": "bash Scripts/package-mac.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:cli-adapters": "node scripts/test-cli-adapters.mjs"
  },
  "build": {
    "appId": "bot.blinky.shell",
    "productName": "BlinkyBot",
    "copyright": "BlinkyBot. Licensed under the MIT License.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      {
        "from": "vm-image",
        "to": "vm-image"
      },
      {
        "from": "out/main",
        "to": "guest-runtime"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "Scripts/sparkle-public-key.txt",
        "to": "sparkle-public-key.txt"
      }
    ],
    "mac": {
      "identity": null,
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "minimumSystemVersion": "14.0",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "BlinkyBot needs camera access only if you attach camera input to a bot.",
        "NSMicrophoneUsageDescription": "BlinkyBot needs microphone access only if you use voice input.",
        "NSAppleEventsUsageDescription": "BlinkyBot uses AppleScript to let bots control apps on your behalf during computer-use actions.",
        "SUFeedURL": "https://github.com/harrisliangsu/blinky-bot/releases/latest/download/appcast.xml",
        "SUPublicEDKey": "M/xUmNfKp+sEloy822L8X4lVdOLM1pv9srD7fw/bgb8=",
        "SUEnableAutomaticChecks": true,
        "SUScheduledCheckInterval": 43200,
        "SUAutomaticallyUpdate": false
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
